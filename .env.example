# Studio Class Booking — environment variables
#
# Copy to `.env` for local development:   cp .env.example .env
# Never commit `.env` — it is covered by .gitignore.
# Real credentials live in the host's secret store (Vercel / GitHub Actions), never here.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the application at runtime.
# Local development (matches docker-compose.yml):
DATABASE_URL="postgresql://studio:studio@localhost:5432/studio_dev?schema=public"

# In production this is the POOLED endpoint. Prisma must not use prepared
# statements through a transaction pooler, hence the pgbouncer flag, e.g.:
#   DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true&connection_limit=1"

# ---------------------------------------------------------------------------
# Not yet consumed by the application — added in the phase that needs them.
# Listed here so the full inventory is visible in one place.
# ---------------------------------------------------------------------------

# Phase 2 (schema & migrations): the DIRECT, non-pooled endpoint.
# Migrations cannot run through a transaction pooler.
# DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# Phase 3 (authentication): secret used to derive/sign the session cookie.
# Generate with: openssl rand -base64 32
# SESSION_COOKIE_SECRET=""

# Phase 4 (dates & aggregates): IANA timezone the studio operates in.
# Every "today", "this week" and the 7-day membership alert window derive from it.
# STUDIO_TIMEZONE="Europe/London"

# Phase 7 (seed data): guard on the seed script. Never set in production.
# ALLOW_SEED="false"
