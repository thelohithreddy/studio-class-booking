# Studio Class Booking — environment variables
#
# Copy to `.env` for local development:   cp .env.example .env
# Never commit `.env` — it is covered by .gitignore.
# Real credentials live in the host's secret store (Vercel / GitHub Actions), never here.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the application at runtime.
# Local development (matches docker-compose.yml):
DATABASE_URL="postgresql://studio:studio@localhost:5432/studio_dev?schema=public"

# In production this is the POOLED endpoint, e.g.:
#   DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Note: with the Prisma 7 driver adapter, `pgbouncer=true` / `connection_limit`
# URL params are dead letters — node-postgres ignores them. Client-side pool
# size is set in code (PrismaPg pool config) during the deploy phase.

# Integration tests only: overrides which database the test harness targets.
# The harness DROPs and remigrates the schema it points at, refuses any
# database whose name does not end in "test", and defaults to studio_test on
# the DATABASE_URL server when unset. CI sets it explicitly.
# TEST_DATABASE_URL="postgresql://studio:studio@localhost:5432/studio_test"

# ---------------------------------------------------------------------------
# Not yet consumed by the application — added in the phase that needs them.
# Listed here so the full inventory is visible in one place.
# ---------------------------------------------------------------------------

# Phase 2 (schema & migrations): the DIRECT, non-pooled endpoint.
# Migrations cannot run through a transaction pooler.
# DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# Phase 3 (authentication): NO secret required — a deliberate reversal of the
# original plan (see docs/decisions.md #13). Sessions are opaque 32-byte
# random tokens stored hashed in Postgres; nothing needs signing.

# IANA timezone the studio operates in. Every "today" the booking logic (and
# the later alert window) computes derives from it. Optional; defaults to UTC.
STUDIO_TIMEZONE="Europe/London"

# Phase 7 (seed data): guard on the seed script. Never set in production.
# ALLOW_SEED="false"
